<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!--
	  La app no usa criptografia propia, solo HTTPS del sistema: con esto TestFlight y App Store
	  Connect dejan de preguntar por cumplimiento de exportacion en cada subida.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- DEV: permite HTTP plano hacia el backend local. Quitar cuando el backend sea HTTPS fijo. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
